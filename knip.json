{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/index.ts", "scripts/*.ts", "test/**/*.test.ts"],
  "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
  "ignore": ["docs/**", "src/services/image/templates/**"],
  "ignoreDependencies": ["lefthook", "@biomejs/biome"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "types": "off",
    "duplicates": "off",
    "enumMembers": "off",
    "classMembers": "off",
    "nsTypes": "off",
    "nsExports": "off"
  }
}
