# Required
BOT_TOKEN=your_telegram_bot_token

# ─── AI providers (all REQUIRED — no hardcoded defaults) ────────────────────

# AI primary — z.ai coding endpoint (GLM 5.1 via OpenAI-compat API)
ZAI_API_KEY=your_zai_api_key
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.1
ZAI_FAST_MODEL=glm-4.7-flash

# HuggingFace Router (fallback, tool calling capable)
HF_TOKEN=your_hf_token
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen3-235B-A22B
HF_FAST_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Google Gemini (fallback, tool calling capable)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash

# ─── Database ───────────────────────────────────────────────────────────────

DATABASE_PATH=./data/calendar.db

# Environment
NODE_ENV=development

# Redis (required for: Google Calendar sync, image rendering, voice calls)
REDIS_URL=redis://localhost:6379
# Redis password — set in production for defense-in-depth; used in docker-compose as REDIS_PASSWORD
# REDIS_PASSWORD=change_me_in_production

# Bot admin Telegram user ID (for feedback forwarding and intent verification)
BOT_ADMIN_ID=
# Max IntentLearner API calls per day (default: 100)
INTENT_LEARNER_DAILY_LIMIT=100

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_API_KEY=  # Google Maps Platform key (Geocoding + Places APIs)
ENCRYPTION_KEY=  # 64 hex chars (32 bytes for AES-256-GCM)
PUBLIC_DOMAIN=   # e.g., bot.example.com

# Voice Calls (optional — requires Redis + MTProto user account)
MTPROTO_API_ID=       # From https://my.telegram.org
# Dedicated service account ID; never an arbitrary end-user session
MTPROTO_SERVICE_USER_ID=
MTPROTO_API_HASH=     # From https://my.telegram.org
# Session: authenticate via scripts/pyrogram-auth.py (creates data/voice_caller.session)
DEEPGRAM_API_KEY=     # For live call STT (Nova/Flux streaming)

# Bot identity (used for @mention detection in groups)
BOT_USERNAME=HyperCalendarBot

# Inline bot (separate bot for inline sharing, same process)
INLINE_BOT_TOKEN=
INLINE_BOT_USERNAME=

# OAuth server (optional)
OAUTH_SERVER_PORT=3000

# macOS agent (optional — required only if using agent infrastructure)
AGENT_JWT_SECRET=   # min 32 chars; validated at runtime when agent pairing is used
AGENT_DOWNLOAD_URL= # public URL for agent binary download; used in /connect command

# Silero TTS (optional — high-quality Russian TTS via local Python venv)
SILERO_PYTHON_PATH= # path to python3 in a venv with silero_tts installed (e.g. /opt/silero/bin/python3)
