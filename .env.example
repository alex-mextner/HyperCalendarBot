# Required
BOT_TOKEN=your_telegram_bot_token

# ─── AI providers (all REQUIRED — no hardcoded defaults) ────────────────────

# AI primary — z.ai coding endpoint (GLM 5.1 via OpenAI-compat API)
ZAI_API_KEY=your_zai_api_key
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODEL=glm-5.1
ZAI_FAST_MODEL=glm-4.7-flash

# HuggingFace Router (fallback, tool calling capable)
HF_TOKEN=your_hf_token
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=Qwen/Qwen3-235B-A22B
HF_FAST_MODEL=meta-llama/Llama-3.3-70B-Instruct

# Google Gemini (fallback, tool calling capable)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash
# Optional conservative application budget, NOT the Google project entitlement.
# All bot processes using the project share scope and the DATABASE_PATH sidecar.
# Confirm current project/model quotas in AI Studio before setting these values.
# GEMINI_RATE_LIMITS={"scope":"shared-google-project","rpm":2,"tpm":20000,"rpd":20}

# Anthropic Claude (optional, paid reserve): tried right after z.ai in both default chains,
# skipped when the token or the chain's model is unset. OpenAI-compatible endpoint.
# CLAUDE_API_TOKEN=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_FAST_MODEL=claude-haiku-5-5

# ─── Database ───────────────────────────────────────────────────────────────

DATABASE_PATH=./data/calendar.db

# Environment
NODE_ENV=development

# Redis (required for: Google Calendar sync, image rendering, reminders, /connect_telegram session keepalive, AI-scheduled messages, voice calls)
REDIS_URL=redis://localhost:6379
# Redis password — required by docker-compose.yml (redis refuses to start without it); must not contain " \ / ? # %, tab, CR or LF (redis refuses to start with them)
# REDIS_PASSWORD=change_me_in_production

# Bot admin Telegram user ID (for feedback forwarding and intent verification)
BOT_ADMIN_ID=
# Max IntentLearner API calls per day (default: 100)
INTENT_LEARNER_DAILY_LIMIT=100

# Google Calendar (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_API_KEY=  # Google Maps Platform key (Geocoding + Places APIs)
ENCRYPTION_KEY=  # 64 hex chars (32 bytes for AES-256-GCM)
PUBLIC_DOMAIN=   # e.g., bot.example.com

# Telegram app credentials (optional) — used by /connect_telegram and the MTProto service tier
MTPROTO_API_ID=       # From https://my.telegram.org
MTPROTO_API_HASH=     # From https://my.telegram.org

# /connect_telegram (optional): a user connects their own Telegram account, which then sends
# their invitations to people who never started the bot.
TELEGRAM_SESSION_MASTER_KEY=  # 64 hex chars (32 bytes); encrypts the stored user sessions

# MTProto service tier (optional, OFF unless set): a dedicated service account for @username resolve,
# profile lookup, group member listing, birthday auto-sync and voice-call reminders. It never sends
# messages. Authorize via scripts/pyrogram-auth.py (creates data/voice_caller.session); startup enables
# the tier only if scripts/check-session.py reports exactly this ID. Telegram may block such accounts.
MTPROTO_SERVICE_USER_ID=  # numeric Telegram ID of the dedicated service account; never an end-user
DEEPGRAM_API_KEY=     # For live call STT (Nova/Flux streaming)
# DISABLE_VOICE=true  # opt out of voice calls while keeping the rest of the service tier

# Bot identity (used for @mention detection in groups)
BOT_USERNAME=HyperCalendarBot

# Inline bot (separate bot for inline sharing, same process)
INLINE_BOT_TOKEN=
INLINE_BOT_USERNAME=

# OAuth server (optional)
OAUTH_SERVER_PORT=3000

# macOS agent (optional — required only if using agent infrastructure)

# Silero TTS (optional — high-quality Russian TTS via local Python venv)
SILERO_PYTHON_PATH= # path to python3 in a venv with silero_tts installed (e.g. /opt/silero/bin/python3)
