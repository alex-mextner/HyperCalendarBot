{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    // Follow package symlinks so transitive Bun/Fetch types resolve in a clean isolated install.
    "preserveSymlinks": false,
    // Only this checkout's own @types: a worktree nested in another checkout must not load its stale ones.
    "typeRoots": ["./node_modules/@types"],
    // bun-types imports undici-types without declaring it. From Bun's global store only the
    // isolated linker's hoisted directory can resolve it; a hoisted install falls back to node_modules.
    "paths": { "undici-types": ["./node_modules/.bun/node_modules/undici-types"] },
    "customConditions": ["bun"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "exclude": ["node_modules"]
}
