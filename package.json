{
  "name": "hypercalendarbot",
  "version": "0.1.1",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "start": "bun run src/index.ts",
    "test:call": "bun run scripts/test-call.ts",
    "postinstall": "lefthook install",
    "agent:build": "cd packages/agent-macos && bun run build:app",
    "agent:install": "pkill -f HyperBotAgent 2>/dev/null; sleep 1; cd packages/agent-macos && bun run install:app && open /Applications/HyperBotAgent.app"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "latest",
    "lefthook": "^2.1.4",
    "pino-pretty": "^13.1.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "tar": "^7.5.22",
    "tmp": "^0.2.7",
    "ws": "^8.21.0",
    "form-data": "^4.0.6",
    "@xmldom/xmldom": "^0.8.13",
    "js-yaml": "^4.3.0"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@gramio/scenes": "^0.5.1",
    "@gramio/storage-sqlite": "^0.0.2",
    "@huggingface/inference": "^4.13.15",
    "bullmq": "^5.71.0",
    "city-timezones": "^1.3.3",
    "date-fns": "^4.1.0",
    "date-holidays": "^3.26.9",
    "geo-tz": "^8.1.6",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "gramio": "^0.7.0",
    "jose": "^6.2.2",
    "libphonenumber-js": "^1.12.8",
    "lvovich": "^2.1.0",
    "marked": "^15.0.12",
    "mitt": "^3.0.1",
    "openai": "^6.34.0",
    "pino": "^10.3.1",
    "playwright": "^1.59.1",
    "playwright-core": "^1.59.1",
    "rrule": "^2.8.1",
    "zod": "^4.3.6"
  }
}
