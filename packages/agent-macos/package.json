{
  "name": "@hypercalendarbot/agent-macos",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "electron-builder --dir && electron dist/mac-arm64/HyperBotAgent.app",
    "build": "tsc --project tsconfig.json",
    "dist": "electron-builder --mac",
    "build:app": "tsc --project tsconfig.json && electron-builder --mac --dir",
    "install:app": "cp -f dist/mac-arm64/HyperBotAgent.app/Contents/Resources/app.asar /Applications/HyperBotAgent.app/Contents/Resources/app.asar && cp -Rf dist/mac-arm64/HyperBotAgent.app/Contents/Resources/app.asar.unpacked /Applications/HyperBotAgent.app/Contents/Resources/app.asar.unpacked && echo 'Installed'",
    "install:launchagent": "ln -sf \"$(pwd)/ru.invntrm.hyperbot-agent.plist\" ~/Library/LaunchAgents/ru.invntrm.hyperbot-agent.plist && launchctl unload ~/Library/LaunchAgents/ru.invntrm.hyperbot-agent.plist 2>/dev/null; launchctl load ~/Library/LaunchAgents/ru.invntrm.hyperbot-agent.plist && echo 'LaunchAgent installed'"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "keytar": "^7.9.0",
    "playwright": "^1.40.0",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/keytar": "^4.4.2",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.0.0",
    "electron": "41.10.7",
    "electron-builder": "^26.0.0",
    "electron-builder-squirrel-windows": "^26.15.3",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "ai.hyperide.hyperbotAgent",
    "productName": "HyperBotAgent",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "target": ["dmg", "pkg"]
    },
    "dmg": {
      "window": { "width": 540, "height": 380 },
      "contents": [
        { "x": 169, "y": 190, "type": "file" },
        { "x": 371, "y": 190, "type": "link", "path": "/Applications" }
      ]
    },
    "files": [
      "dist/**/*",
      "!dist/mac-arm64",
      "!dist/HyperBotAgent-*",
      "!dist/*.blockmap",
      "!dist/distribution.xml",
      "!dist/builder-debug.yml",
      "assets/**/*"
    ]
  }
}
