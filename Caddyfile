hypercal.invntrm.ru {
	# All bot API paths — retry during container restarts so clients see a delay, not 502.
	# Caddy holds the connection and retries every 500ms for up to 10s.
	@bot path /webhook/* /oauth/* /webhooks/* /ws/* /health /admin/*
	handle @bot {
		# Both ports always present: lb_policy first prefers 3001.
		# When 3001 is down, Caddy auto-routes to 3002 (green container during deploy).
		# No sed/caddy-reload needed in deploy scripts.
		reverse_proxy localhost:3001 localhost:3002 {
			lb_policy       first
			health_uri      /health
			health_interval 2s
			health_timeout  3s
			lb_try_duration 10s
			lb_try_interval 500ms
		}
	}

	# Agent download — redirect bare name to .dmg
	redir /downloads/agent-macos /downloads/agent-macos.dmg 301

	# Agent download — static files from /opt/hypercal/downloads/
	handle /downloads/* {
		root * /opt/hypercal
		file_server
	}

	# Non-API paths — static response (bot doesn't serve pages)
	handle {
		respond "HyperCalendarBot is running" 200
	}

	log {
		output file /var/log/caddy/hypercal.invntrm.ru.log {
			roll_size 50mb
			roll_keep 5
			roll_keep_for 720h
		}
		format console
	}
}
