# DigitalOcean ingress for hypercal.invntrm.ru (#784). Since 2026-10-09 the bot runs on
# the home ODROID-N2+ and this Caddy only forwards to it, so the public domain, OAuth
# redirect, Calendar watch channels and Telegram webhook URL did not change. Applied by
# hand to the DO droplet's Caddy followed by `caddy reload`; deploys copy this file to
# /opt/hypercal on the odroid but never load it there.
#
# The upstream is the odroid's tailnet address and the bot's published port: the droplet
# is tailnet node do-edge (100.113.21.91) with a direct WireGuard path to the odroid.
# Tailscale Funnel, the first route, failed on 2026-10-10 from 00:00 to 03:10 UTC (two of
# its three ingress IPs reset TLS), so Funnel is off on the odroid and nothing here
# depends on it.
hypercal.invntrm.ru {
	# All bot API paths — retry during container restarts so clients see a delay, not 502.
	# Caddy holds the connection and retries every 500ms for up to 10s.
	@bot path /webhook/* /oauth/* /webhooks/* /ws/* /health /ready /admin/*
	handle @bot {
		reverse_proxy 100.116.57.66:3001 {
			lb_try_duration 10s
			lb_try_interval 500ms
		}
	}

	# Non-API paths — static response (bot doesn't serve pages)
	handle {
		respond "HyperCalendarBot is running" 200
	}

	log {
		output file /var/log/caddy/hypercal.invntrm.ru.log {
			roll_size 50mb
			roll_keep 5
			roll_keep_for 720h
		}
		format console
	}
}
