hypercal.invntrm.ru {
	# All bot API paths — retry during container restarts so clients see a delay, not 502.
	# Caddy holds the connection and retries every 500ms for up to 10s.
	@bot path /webhook/* /oauth/* /webhooks/* /ws/* /health /ready /admin/*
	handle @bot {
		reverse_proxy localhost:3001 {
			lb_try_duration 10s
			lb_try_interval 500ms
		}
	}

	# Non-API paths — static response (bot doesn't serve pages)
	handle {
		respond "HyperCalendarBot is running" 200
	}

	log {
		output file /var/log/caddy/hypercal.invntrm.ru.log {
			roll_size 50mb
			roll_keep 5
			roll_keep_for 720h
		}
		format console
	}
}
